# ------------------------------------------------------------
# Files that must never be committed to this public repository
# ------------------------------------------------------------

# Secrets and credentials (data protection: SR-04)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials
credentials.*
.aws/
*.tfvars
!example.tfvars

# Unredacted evidence. Keep originals here; commit only redacted copies.
evidence/raw/

# Terraform: state can contain sensitive values and lives in S3, not Git
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Editors and operating systems
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local app data (synthetic, created by scripts/run_app.py)
.local-data/
